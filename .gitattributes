*.sh text eol=lf
*.md text eol=lf
SHA256SUMS text eol=lf

# A unified diff intentionally contains context lines beginning with a marker
# space followed by Go indentation. Do not treat that patch payload as source
# whitespace when running git diff --check.
patches/xray-core-quic-sniff.patch -whitespace
patches/*.patch text eol=lf
patches/*.patch -whitespace
