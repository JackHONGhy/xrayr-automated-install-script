+func TestSniffQUICMalformedCryptoFrameDoesNotPanic(t *testing.T) {
+	pkt := makeTestInitialPacket([]byte{0x06, 0x80, 0x00, 0x01, 0xaa})
+
+	var (
+		header   *SniffHeader
+		err      error
+		panicked interface{}
+	)
+	func() {
+		defer func() {
+			panicked = recover()
+		}()
+		header, err = SniffQUIC(pkt)
+	}()
+
+	if panicked != nil {
+		t.Fatalf("SniffQUIC panicked on malformed CRYPTO frame: %v", panicked)
+	}
+	if header != nil {
+		t.Fatalf("expected no sniff header, got domain %q", header.Domain())
+	}
+	if err == nil {
+		t.Fatal("expected a safe parsing error")
+	}
+}
+
+func TestSniffQUICCryptoFrameLimit(t *testing.T) {
+	// 32767 is the maximum accepted CRYPTO offset; adding two bytes must be
+	// rejected before any slice operation or allocation can occur.
+	pkt := makeTestInitialPacket([]byte{0x06, 0x80, 0x00, 0x7f, 0xff, 0x02, 0xaa, 0xbb})
+
+	var (
+		header *SniffHeader
+		err    error
+	)
+	func() {
+		defer func() {
+			if recovered := recover(); recovered != nil {
+				t.Fatalf("SniffQUIC panicked on oversized CRYPTO frame: %v", recovered)
+			}
+		}()
+		header, err = SniffQUIC(pkt)
+	}()
+
+	if header != nil {
+		t.Fatalf("expected no sniff header, got domain %q", header.Domain())
+	}
+	if err != io.ErrShortBuffer {
+		t.Fatalf("expected io.ErrShortBuffer, got %v", err)
+	}
+}
