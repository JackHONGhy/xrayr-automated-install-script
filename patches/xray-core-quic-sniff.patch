+
+// readShortQuicVarint bounds values used as packet lengths, offsets, counts,
+// or slice lengths before converting them to int32 or using them in loops.
+func readShortQuicVarint(reader io.ByteReader) (int32, error) {
+	v, err := quicvarint.Read(reader)
+	if err != nil {
+		return 0, err
+	}
+	if v > 65535 {
+		return 0, errNotQuicInitial
+	}
+	return int32(v), nil
+}
