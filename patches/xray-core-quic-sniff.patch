+func FuzzSniffQUIC(f *testing.F) {
+	f.Add([]byte{0x06, 0x80, 0x00, 0x01, 0xaa})
+	f.Add([]byte{0xcb, 0x00, 0x00, 0x00, 0x01, 0x08, 0x1c, 0x8c})
