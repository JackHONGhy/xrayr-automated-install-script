+func makeTestInitialPacket(payload []byte) []byte {
+	dcid := []byte{0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08}
+	scid := []byte{0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10}
+	header := []byte{0xc0, 0, 0, 0, 1, byte(len(dcid))}
+	header = append(header, dcid...)
+	header = append(header, byte(len(scid)))
+	header = append(header, scid...)
+	header = append(header, 0) // Token Length
+	header = append(header, byte(1+len(payload)+16))
+
+	packetNumber := byte(0)
+	associatedData := append(append([]byte{}, header...), packetNumber)
+	initialSecret := hkdf.Extract(crypto.SHA256.New, dcid, quicSalt)
+	secret := hkdfExpandLabel(crypto.SHA256, initialSecret, []byte{}, "client in", crypto.SHA256.Size())
+	hpKey := hkdfExpandLabel(crypto.SHA256, secret, []byte{}, "quic hp", initialSuite.KeyLen)
+	key := hkdfExpandLabel(crypto.SHA256, secret, []byte{}, "quic key", 16)
+	iv := hkdfExpandLabel(crypto.SHA256, secret, []byte{}, "quic iv", 12)
+	cipher := AEADAESGCMTLS13(key, iv)
+	nonce := make([]byte, cipher.NonceSize())
+	binary.BigEndian.PutUint64(nonce[len(nonce)-8:], uint64(packetNumber))
+	ciphertext := cipher.Seal(nil, nonce, payload, associatedData)
+	packet := append(associatedData, ciphertext...)
+
+	hpBlock, err := aes.NewCipher(hpKey)
+	if err != nil {
+		panic(err)
+	}
+	mask := make([]byte, hpBlock.BlockSize())
+	hpBlock.Encrypt(mask, packet[len(header)+1+3:len(header)+1+3+16])
+	packet[0] ^= mask[0] & 0xf
+	packet[len(header)] ^= mask[1]
+	return packet
+}
