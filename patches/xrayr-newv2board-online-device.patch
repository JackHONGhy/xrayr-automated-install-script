 // ReportNodeOnlineUsers implements the API interface
 func (c *APIClient) ReportNodeOnlineUsers(onlineUserList *[]api.OnlineUser) error {
+	data, deviceCount := normalizeOnlineUsers(onlineUserList)
+	payload, err := marshalOnlineUsers(data)
+	if err != nil {
+		err = newOnlineReportError("encode")
+		log.WithFields(onlineReportFields(c.NodeID, data, deviceCount, err)).Error("Report online devices failed")
+		return err
+	}
+
+	path := "/api/v1/server/UniProxy/alive"
+	res, err := c.client.R().
+		SetHeader("Content-Type", "application/json").
+		SetBody(payload).
+		Post(path)
+	if err != nil {
+		err = newOnlineReportError(classifyOnlineRequestError(err))
+		log.WithFields(onlineReportFields(c.NodeID, data, deviceCount, err)).Error("Report online devices failed")
+		return err
+	}
+	if res == nil {
+		err = newOnlineReportError("network")
+		log.WithFields(onlineReportFields(c.NodeID, data, deviceCount, err)).Error("Report online devices failed")
+		return err
+	}
+	if res.StatusCode() < 200 || res.StatusCode() >= 300 {
+		err = newOnlineReportError(fmt.Sprintf("http_%d", res.StatusCode()))
+		log.WithFields(onlineReportFields(c.NodeID, data, deviceCount, err)).Error("Report online devices failed")
+		return err
+	}
+
+	var response onlineReportResponse
+	if err = json.Unmarshal(res.Body(), &response); err != nil {
+		err = newOnlineReportError("invalid_response")
+		log.WithFields(onlineReportFields(c.NodeID, data, deviceCount, err)).Error("Report online devices failed")
+		return err
+	}
+	if response.Data == nil || !*response.Data {
+		err = newOnlineReportError("business_response")
+		log.WithFields(onlineReportFields(c.NodeID, data, deviceCount, err)).Error("Report online devices failed")
+		return err
+	}
+
+	log.WithFields(onlineReportFields(c.NodeID, data, deviceCount, nil)).Info("Report online devices accepted")
 	return nil
 }
 
+type onlineReportResponse struct {
+	Data *bool `json:"data"`
+}
+
+type onlineReportError struct {
+	kind string
+}
+
+func (e *onlineReportError) Error() string {
+	return "online report failed: " + e.kind
+}
+
+func newOnlineReportError(kind string) error {
+	return &onlineReportError{kind: kind}
+}
+
+func onlineReportFields(nodeID int, data map[int][]string, deviceCount int, err error) log.Fields {
+	fields := log.Fields{
+		"node_id": nodeID,
+		"users":   len(data),
+		"devices": deviceCount,
+	}
+	if err != nil {
+		var reportErr *onlineReportError
+		if errors.As(err, &reportErr) {
+			fields["error_type"] = reportErr.kind
+		} else {
+			fields["error_type"] = "unknown"
+		}
+	}
+	return fields
+}
+
+func classifyOnlineRequestError(err error) string {
+	if errors.Is(err, context.DeadlineExceeded) {
+		return "timeout"
+	}
+	var netErr net.Error
+	if errors.As(err, &netErr) && netErr.Timeout() {
+		return "timeout"
+	}
+	return "network"
+}
+
+func normalizeOnlineUsers(onlineUserList *[]api.OnlineUser) (map[int][]string, int) {
+	addresses := make(map[int]map[string]struct{})
+	if onlineUserList == nil {
+		return make(map[int][]string), 0
+	}
+
+	for _, onlineUser := range *onlineUserList {
+		if onlineUser.UID <= 0 {
+			continue
+		}
+		ipText := strings.TrimSpace(onlineUser.IP)
+		if ipText == "" {
+			continue
+		}
+		parsedIP := net.ParseIP(ipText)
+		if parsedIP == nil {
+			continue
+		}
+		canonicalIP := parsedIP.String()
+		if ipv4 := parsedIP.To4(); ipv4 != nil {
+			canonicalIP = ipv4.String()
+		}
+		if addresses[onlineUser.UID] == nil {
+			addresses[onlineUser.UID] = make(map[string]struct{})
+		}
+		addresses[onlineUser.UID][canonicalIP] = struct{}{}
+	}
+
+	data := make(map[int][]string, len(addresses))
+	deviceCount := 0
+	for uid, addressSet := range addresses {
+		ips := make([]string, 0, len(addressSet))
+		for ip := range addressSet {
+			ips = append(ips, ip)
+		}
+		sort.Strings(ips)
+		if len(ips) == 0 {
+			continue
+		}
+		data[uid] = ips
+		deviceCount += len(ips)
+	}
+
+	return data, deviceCount
+}
+
+func marshalOnlineUsers(data map[int][]string) ([]byte, error) {
+	uids := make([]int, 0, len(data))
+	for uid := range data {
+		uids = append(uids, uid)
+	}
+	sort.Ints(uids)
+
+	var builder strings.Builder
+	builder.WriteByte('{')
+	for i, uid := range uids {
+		if i > 0 {
+			builder.WriteByte(',')
+		}
+		key, err := json.Marshal(strconv.Itoa(uid))
+		if err != nil {
+			return nil, err
+		}
+		value, err := json.Marshal(data[uid])
+		if err != nil {
+			return nil, err
+		}
+		builder.Write(key)
+		builder.WriteByte(':')
+		builder.Write(value)
+	}
+	builder.WriteByte('}')
+	return []byte(builder.String()), nil
+}
