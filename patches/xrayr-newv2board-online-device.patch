+
+func newOnlineReportClient(serverURL string, timeout int) *newV2board.APIClient {
+	return newV2board.New(&api.Config{
+		APIHost:  serverURL,
+		NodeID:   42,
+		Key:      "test-token",
+		NodeType: "V2ray",
+		Timeout:  timeout,
+	})
+}
+
+func TestReportNodeOnlineUsersPostsXBoardPayload(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Errorf("method = %s, want POST", r.Method)
+		}
+		if r.URL.Path != "/api/v1/server/UniProxy/alive" {
+			t.Errorf("path = %s, want /api/v1/server/UniProxy/alive", r.URL.Path)
+		}
+		if got := r.Header.Get("Content-Type"); got != "application/json" {
+			t.Errorf("Content-Type = %q, want application/json", got)
+		}
+		query := r.URL.Query()
+		if query.Get("node_id") != "42" || query.Get("node_type") != "v2ray" || query.Get("token") != "test-token" {
+			t.Errorf("authentication query = %v", query)
+		}
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+		}
+		wantBody := `{"2":["198.51.100.7"],"42":["192.0.2.1","2001:db8::1"]}`
+		if string(body) != wantBody {
+			t.Errorf("body = %s, want %s", body, wantBody)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"data":true}`)
+	}))
+	defer server.Close()
+
+	onlineUsers := []api.OnlineUser{
+		{UID: 42, IP: " 192.0.2.1 "},
+		{UID: 42, IP: "192.0.2.1"},
+		{UID: 42, IP: "2001:0DB8:0000:0000:0000:0000:0000:0001"},
+		{UID: 42, IP: "2001:db8::1"},
+		{UID: 2, IP: "::ffff:198.51.100.7"},
+		{UID: 0, IP: "203.0.113.1"},
+		{UID: -1, IP: "203.0.113.2"},
+		{UID: 42, IP: ""},
+		{UID: 42, IP: "not-an-ip"},
+	}
+
+	if err := newOnlineReportClient(server.URL, 2).ReportNodeOnlineUsers(&onlineUsers); err != nil {
+		t.Fatalf("ReportNodeOnlineUsers() error = %v", err)
+	}
+}
+
+func TestReportNodeOnlineUsersEmptyList(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+		}
+		if string(body) != "{}" {
+			t.Errorf("body = %s, want {}", body)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"data":true}`)
+	}))
+	defer server.Close()
+
+	var onlineUsers []api.OnlineUser
+	if err := newOnlineReportClient(server.URL, 2).ReportNodeOnlineUsers(&onlineUsers); err != nil {
+		t.Fatalf("ReportNodeOnlineUsers(empty) error = %v", err)
+	}
+}
+
+func TestReportNodeOnlineUsersHTTPFailures(t *testing.T) {
+	for _, status := range []int{http.StatusUnauthorized, http.StatusForbidden, http.StatusNotFound, http.StatusTooManyRequests, http.StatusInternalServerError} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.WriteHeader(status)
+				_, _ = io.WriteString(w, `{"data":true}`)
+			}))
+			defer server.Close()
+
+			onlineUsers := []api.OnlineUser{{UID: 1, IP: "192.0.2.1"}}
+			if err := newOnlineReportClient(server.URL, 2).ReportNodeOnlineUsers(&onlineUsers); err == nil {
+				t.Fatalf("ReportNodeOnlineUsers(status %d) returned nil", status)
+			}
+		})
+	}
+}
+
+func TestReportNodeOnlineUsersInvalidResponses(t *testing.T) {
+	for _, responseBody := range []string{
+		"not-json",
+		`{}`,
+		`{"data":false}`,
+		`{"data":"true"}`,
+		`[]`,
+	} {
+		t.Run(strings.ReplaceAll(responseBody, "\"", "quote"), func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = io.WriteString(w, responseBody)
+			}))
+			defer server.Close()
+
+			onlineUsers := []api.OnlineUser{{UID: 1, IP: "192.0.2.1"}}
+			if err := newOnlineReportClient(server.URL, 2).ReportNodeOnlineUsers(&onlineUsers); err == nil {
+				t.Fatalf("ReportNodeOnlineUsers(%q) returned nil", responseBody)
+			}
+		})
+	}
+}
+
+func TestReportNodeOnlineUsersTimeout(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case <-r.Context().Done():
+		case <-time.After(2 * time.Second):
+		}
+	}))
+	defer server.Close()
+
+	onlineUsers := []api.OnlineUser{{UID: 1, IP: "192.0.2.1"}}
+	if err := newOnlineReportClient(server.URL, 1).ReportNodeOnlineUsers(&onlineUsers); err == nil {
+		t.Fatal("ReportNodeOnlineUsers(timeout) returned nil")
+	}
+}
+
+func TestReportNodeOnlineUsersConnectionFailure(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	serverURL := server.URL
+	server.Close()
+
+	onlineUsers := []api.OnlineUser{{UID: 1, IP: "192.0.2.1"}}
+	if err := newOnlineReportClient(serverURL, 1).ReportNodeOnlineUsers(&onlineUsers); err == nil {
+		t.Fatal("ReportNodeOnlineUsers(connection failure) returned nil")
+	}
+}
+
+func TestReportNodeOnlineUsersCanRetryNextRound(t *testing.T) {
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if calls.Add(1) == 1 {
+			w.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"data":true}`)
+	}))
+	defer server.Close()
+
+	onlineUsers := []api.OnlineUser{{UID: 1, IP: "192.0.2.1"}}
+	client := newOnlineReportClient(server.URL, 2)
+	if err := client.ReportNodeOnlineUsers(&onlineUsers); err == nil {
+		t.Fatal("first report returned nil")
+	}
+	if err := client.ReportNodeOnlineUsers(&onlineUsers); err != nil {
+		t.Fatalf("second report error = %v", err)
+	}
+	if got := calls.Load(); got < 2 {
+		t.Fatalf("request count = %d, want at least 2", got)
+	}
+}
+
+func TestReportNodeOnlineUsersDoesNotChangeDeviceLimit(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/api/v1/server/UniProxy/user" {
+			t.Errorf("path = %s, want user endpoint", r.URL.Path)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"users":[{"id":1,"uuid":"user-uuid","speed_limit":0,"device_limit":99}]}`)
+	}))
+	defer server.Close()
+
+	client := newV2board.New(&api.Config{
+		APIHost:     server.URL,
+		NodeID:      42,
+		Key:         "test-token",
+		NodeType:    "V2ray",
+		DeviceLimit: 7,
+	})
+	users, err := client.GetUserList()
+	if err != nil {
+		t.Fatalf("GetUserList() error = %v", err)
+	}
+	if got := (*users)[0].DeviceLimit; got != 7 {
+		t.Fatalf("DeviceLimit = %d, want configured value 7", got)
+	}
+}
